# Copy to .env.staging.local (ignored). Use an approved staging project only.
# These credentials are never read by the app or the mocked browser suite.
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
STAGING_EXPECTED_HOST=your-staging-project.supabase.co
STAGING_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Two dedicated, confirmed, non-admin test patients. Run with no other sessions.
STAGING_PATIENT_EMAIL=
STAGING_PATIENT_PASSWORD=
STAGING_OTHER_EMAIL=
STAGING_OTHER_PASSWORD=
STAGING_EXERCISE_ID=
